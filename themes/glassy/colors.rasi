/* ========================================== */
/* قالب ألوان Rofi - يتم توليده تلقائياً بواسطة rice */
/* ========================================== */

* {
    /* الألوان الأساسية */
    background:     #000000;
    background-alt: #111111;
    foreground:     #FFFFFF;
    selected:       #000000;
    active:         #000000;
    urgent:         #000000;
    
    /* الأشكال والقياسات */
    border-radius:  10px;
    border-color:   #000000;
}